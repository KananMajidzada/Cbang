// std.math: every function, every numeric kind, and single evaluation
// of the arguments (min/max must not run a side effect twice).
use std.io;
use std.math;

var count: i32 = 0;
fn bump() i32 { count = count + 1; return count; }

pub fn main() i32 {
    // abs: signed, unsigned, float, literal
    var neg: i32 = -17;
    var big: u64 = 18446744073709551615;
    var f: f64 = -2.5;
    if (math.abs(neg) != 17) { return 1; }
    if (math.abs(big) != 18446744073709551615) { return 1; }
    if (math.abs(f) != 2.5) { return 1; }
    if (math.abs(-42) != 42) { return 1; }

    // min / max: signed ints, unsigned ints, floats, int literal alongside
    if (math.min(3, 7) != 3) { return 1; }
    if (math.max(3, 7) != 7) { return 1; }
    if (math.min(-2.5, 1.5) != -2.5) { return 1; }
    if (math.max(2.5, 1.5) != 2.5) { return 1; }
    if (math.max(big, 5) != 18446744073709551615) { return 1; }
    if (math.min(100, 7) != 7) { return 1; }

    // libm functions
    if (math.sqrt(144.0) != 12.0) { return 1; }
    if (math.pow(2, 10) != 1024.0) { return 1; }
    if (math.floor(2.7) != 2.0) { return 1; }
    if (math.ceil(2.1) != 3.0) { return 1; }
    if (math.round(2.5) != 3.0) { return 1; }

    // arguments evaluated exactly once (a ternary would run bump() twice)
    var r: i32 = math.min(bump(), 5);
    if (count != 1) { return 1; }
    if (r != 1) { return 1; }

    io.print("math ok\n");
    return 0;
}
