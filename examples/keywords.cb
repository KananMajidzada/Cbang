// Test all merged keywords - every declared value gets used.

use std.io;

// Top-level declarations
struct Point { i32 x; i32 y; }
union Data { i32 i; f32 f; }
enum Color { RED, GREEN, BLUE }
type usize = u64;

const u64 GLOBAL_CONST = 100;

fn test() i32 {
    defer { }

    if (true) { } else { }
    for (var x: i32 = 0; x < 10; x = x + 1) { }
    while (false) { }

    const SIZE = sizeof(i32);
    const ALIGN = alignof(i64);
    volatile var reg: u32 = 0;
    var p: *u8 = 0x1000 as *u8;
    var total: u64 = SIZE + ALIGN + reg;
    var addr: uintptr = p as uintptr;

    switch (1) {
        case 1: { total = total + 1; }
        case 2: { total = total + 2; }
    }

    if (total + addr + GLOBAL_CONST == 0) {
        return 1;
    }
    return 0;
}

pub fn main() i32 {
    var a: i8 = 1;
    var b: i16 = 2;
    var c: i32 = 3;
    var d: i64 = 4;
    var e: u8 = 5;
    var f: u16 = 6;
    var g: u32 = 7;
    var h: u64 = 8;
    var i: f32 = 1.0;
    var j: f64 = 2.0;
    var k: bool = true;
    var l: str = "hello";
    var n: uintptr = 0x1000;

    // Use every variable so the C compiler sees no unused warnings
    var sum: i64 = 0;
    sum = sum + a + b + c + d;
    sum = sum + e + f + g;
    sum = sum + h;
    if (k) { sum = sum + 1; }
    sum = sum + i + j;
    sum = sum + n;
    if (l.len == 5) { sum = sum + 1; }

    if (sum == 0) {
        io.print("unreachable\n");
    }
    return test();
}